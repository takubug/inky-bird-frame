# The source checkout tracks trusted main. Release bundles replace this value
# with their immutable release tag.
INKY_BIRD_IMAGE=ghcr.io/veteranbv/inky-bird-frame:latest

# Restrict the published controller port to a trusted interface (for example a
# tailnet address). Unset, the port publishes on all interfaces (0.0.0.0).
# INKY_BIRD_BIND=100.64.0.1
